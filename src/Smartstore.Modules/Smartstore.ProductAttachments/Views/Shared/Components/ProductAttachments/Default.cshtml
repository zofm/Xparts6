@model Smartstore.ProductAttachments.Models.PublicInfoModel

@if (Model.Attachments.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 g-3 product-attachments">
        @foreach (var item in Model.Attachments)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <a href="@Url.Action("DownloadAttachment", "ProductAttachments", new { id = item.Id })"
                           class="btn btn-outline-secondary mt-auto" target="_blank">
                            <i class="bi bi-download me-1"></i>
                            @item.Name
                        </a>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="card-text text-muted mt-2 mb-0"><small>@item.Description</small></p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
